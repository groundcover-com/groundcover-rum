{
  "name": "@groundcover/browser",
  "version": "2.3.0",
  "description": "groundcover Real User Monitoring (RUM) SDK for the browser \u2014 performance, errors, logs, distributed tracing and session replay",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "homepage": "https://docs.groundcover.com/investigate/real-user-monitoring-rum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groundcover-com/groundcover-rum.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/groundcover-com/groundcover-rum/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:worker": "tsup --config tsup.worker.config.ts && node scripts/inline-worker.mjs",
    "build:watch": "npm run build:worker && tsc --noEmit && node scripts/watch.mjs",
    "build": "npm run build:worker && tsc --noEmit && tsup",
    "size": "npm run build && size-limit",
    "lint": "eslint .",
    "test": "vitest run && npm run lint && npm run size",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "rum",
    "sdk",
    "real-user-monitoring",
    "observability",
    "monitoring",
    "session-replay",
    "rrweb",
    "browser",
    "frontend",
    "tracing",
    "groundcover"
  ],
  "author": "groundcover",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@groundcover/rum-core": "workspace:*",
    "@size-limit/file": "^14.3.0",
    "@size-limit/webpack": "^14.3.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.39.5",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "size-limit": "^14.3.0",
    "terser": "^5.39.0",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "error-stack-parser": "2.1.4",
    "fflate": "0.8.3",
    "@rrweb/packer": "2.1.0",
    "rrweb": "2.1.0",
    "web-vitals": "4.2.4"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "100 kB"
    }
  ]
}
