<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared by the plugin, not left to the app: a Flutter app template grants INTERNET
         only in its debug and profile manifests, so a release build would send nothing. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- The engine's launch anchor, as in the RN library's manifest. A provider runs before
             Application.onCreate, which is the only way to stamp launch timings that would
             otherwise be gone by the time any app-level hook (let alone Dart) runs. It
             provides no data. The authority is namespaced with ${applicationId} so two apps
             on one device never collide. -->
        <provider
            android:name="com.groundcover.rum.engine.appstart.GcRumStartupProvider"
            android:authorities="${applicationId}.groundcoverrum.startup"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
