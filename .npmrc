# React Native / Expo require a flat node_modules — Metro's resolver and Expo
# autolinking don't understand pnpm's default isolated (symlinked) layout, so
# transitive deps like expo-modules-core aren't resolvable from the app.
# node-linker=hoisted lays out node_modules flat (like npm/yarn), which is the
# Expo-recommended setting for pnpm monorepos. It does not change lockfile
# contents, so `pnpm install --frozen-lockfile` in CI stays valid.
node-linker=hoisted
