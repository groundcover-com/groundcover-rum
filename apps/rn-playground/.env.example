# Copy to .env and fill in a groundcover RUM ingest endpoint + API key.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.

# HOST ONLY — no /json/rum path. The SDK appends that itself, so a DSN carrying it
# posts to /json/rum/json/rum, which 404s with no other symptom. A scheme is
# optional (a bare host is upgraded to https), but a release build BLOCKS cleartext,
# so http:// works only in a debug build.
EXPO_PUBLIC_GC_DSN=your-rum-ingest-host.groundcover.com
EXPO_PUBLIC_GC_API_KEY=your-rum-api-key

# Which init-time config to boot on. Leave UNSET for e2e and local development —
# the suite selects presets by rewriting src/e2e-preset.ts, and this variable
# overrides that file.
#
# Set it to `device` for a real phone against a real cluster: every other preset
# is tuned for the mock ingest (500ms batches, trace headers to every host, a 1s
# hang threshold), which is wrong rather than merely noisy on a device.
# EXPO_PUBLIC_GC_PRESET=device

# Distinguishes one device build from the next; defaults to 1.0.0, so without it
# every APK you install reports the same release. A short git sha works well.
# EXPO_PUBLIC_GC_RELEASE_ID=abc1234

# `device` only: turns SDK debug logging back on, readable over `adb logcat`.
# Off by default for two reasons: the logging perturbs the frame timings a device run
# is there to measure, and it prints the COMPLETE UNREDACTED batch — session
# attributes included, so whatever `identifyUser` was given lands in adb logcat / the
# Xcode console, where a CI log artifact would keep it. Use it to answer "is anything
# being sent at all?", then unset it; never with a real user identity.
# EXPO_PUBLIC_GC_DEBUG=1
