<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext to two hosts only, in debug builds: 10.0.2.2, where the emulator reaches the host's
     mock ingest (:9393) and echo (:9394), and 127.0.0.1, where the Network tab's failing request
     has to be refused by the socket rather than by this policy. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
