<?xml version="1.0" encoding="utf-8"?>
<!-- The Detail screen, in Views: the Compose screens' title, hint and card, laid out the same. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detail"
        android:textColor="#000000"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Navigating here should emit a `navigation` event and stamp the `screen` block (name &quot;Detail&quot; plus a per-instance key) on it and on every later event."
        android:textColor="#666666"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#F2F2F7"
        android:orientation="vertical"
        android:padding="14dp">

        <Button
            android:id="@+id/detail_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
