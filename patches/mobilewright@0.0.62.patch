@@ -1,3 +1,5 @@
+// PATCHED by groundcover-com/groundcover-rum (patches/mobilewright@0.0.62.patch; see patches/README.md):
+// terminateAppIfRunning also tolerates the iOS simulator's not-running error.
 import { Device } from '@mobilewright/core';
 import { MobilecliDriver, DEFAULT_URL } from '@mobilewright/driver-mobilecli';
 import { toArray } from './config.js';
@@ -43,7 +45,11 @@ export async function terminateAppIfRunning(device, bundleId) {
         await device.terminateApp(bundleId);
     }
     catch (error) {
-        const isNotRunning = error instanceof Error && error.message.includes(`process of ${bundleId} not found`);
+        // groundcover patch: the simulator reports a stopped app too, as `xcrun simctl terminate`'s
+        // exit status 3 ("found nothing to terminate"), which mobilecli 1.0.16 passes on bare.
+        const isNotRunning = error instanceof Error &&
+            (error.message.includes(`process of ${bundleId} not found`) ||
+                error.message.includes('xcrun simctl command: exit status 3'));
         if (!isNotRunning) {
             throw error;
         }
